.env
__pycache__/
.DS_Store

# Virtual environments
.venv/

# Agent sandbox — wiped and regenerated on every run.
# Curated sample output lives in examples/ instead.
#
# Anchored with a leading slash. Unanchored, `sandbox/` matches a directory of that
# name at ANY depth, which silently excluded src/engineering_team/tools/sandbox/ —
# the whole SandboxBackend package — from every commit.
/sandbox/

# CrewAI runtime state
db/
*.db
logs.txt
flow_state/
*.html
!examples/**/*.html
exports/
examples/gym_class_booking/gym_class_booking.zip
.space/

# Local working files: kept on disk, not published.
CLAUDE.md
linkedin-post.md
# The roadmap. Its job was getting the project here; ARCHITECTURE.md describes where it
# landed, which is the only part a reader needs.
PLAN.md
